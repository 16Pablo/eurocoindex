<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Bloquea todo tráfico HTTP sin cifrar en toda la app -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
